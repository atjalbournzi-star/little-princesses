# ==========================================================================
# 👑 LITTLE PRINCESSES ERP — DATABASE ENVIRONMENT CONFIGURATION
# ==========================================================================
# قم بنسخ هذا الملف إلى ملف باسم .env وضع بيانات الاتصال الخاصة بك.

# --------------------------------------------------------------------------
# 1. وضع قاعدة البيانات النشط (Active Database Mode)
# --------------------------------------------------------------------------
# اختر: 'cloud' (قاعدة بيانات سحابية - مستحسن) أو 'local' (سيرفر محلي على جهازك)
DB_MODE=cloud

# --------------------------------------------------------------------------
# 2. إعدادات قاعدة البيانات السحابية (Cloud PostgreSQL - Neon / Supabase)
# --------------------------------------------------------------------------
# 🔹 الطريقة الموصى بها: افتح حساباً مجانياً على https://neon.tech أو https://supabase.com
# 🔹 انسخ رابط الاتصال وضع بدلاً من الرابط النموذجي بالأسفل:
# ملاحظة: تأكد من وجود sslmode=require في نهاية الرابط لضمان الاتصال المشفر الآمن.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# --------------------------------------------------------------------------
# 3. إعدادات حوض الاتصالات (Connection Pool Settings)
# --------------------------------------------------------------------------
# يتحكم في عدد الاتصالات المتزامنة المفتوحة لتسريع الاستجابة ومنع استنزاف موارد السيرفر:
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30

# --------------------------------------------------------------------------
# 4. إعدادات قاعدة البيانات المحلية (Local PostgreSQL - اختياري)
# --------------------------------------------------------------------------
# في حال كنت تشغل PostgreSQL محلياً على جهازك وتريد العمل دون إنترنت:
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=little_princesses_erp
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/little_princesses_erp

# --------------------------------------------------------------------------
# 5. العملة الأساسية للنظام (Base Currency Settings)
# --------------------------------------------------------------------------
BASE_CURRENCY=YER
