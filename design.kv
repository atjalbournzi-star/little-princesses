                        id: sz_shoulder_w
                        mode: "rectangle"
                        hint_text: app.get_ar("الكتف")
                        input_filter: "float"
                    MDTextField:
                        id: sz_chest_c
                        mode: "rectangle"
                        hint_text: app.get_ar("الصدر")
                        input_filter: "float"
                    MDTextField:
                        id: sz_waist_c
                        mode: "rectangle"
                        hint_text: app.get_ar("الخصر")
                        input_filter: "float"
                    MDTextField:
                        id: sz_sleeve_l
                        mode: "rectangle"
                        hint_text: app.get_ar("الكم")
                        input_filter: "float"
                    MDTextField:
                        id: sz_chest_l
                        mode: "rectangle"
                        hint_text: app.get_ar("طول الصدر")
