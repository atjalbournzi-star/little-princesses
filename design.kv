MDScreenManager:
    LoginScreen:
    DashboardScreen:
    FactoryScreen:
    SalesScreen:
    CustomersSmartScreen:
    InventoryScreen:
    ModelsCostingScreen:
    PurchasesScreen:
    ExpensesScreen:
    JournalEntriesScreen:
    VouchersScreen:
    ReportsScreen:
    AccountsTreeScreen:
    SettingsScreen:

# ====================================
# 0. شاشة تسجيل الدخول
# ====================================
<LoginScreen>:
    name: 'login'
    MDFloatLayout:
        md_bg_color: 0.98, 0.97, 0.99, 1
        MDCard:
            size_hint: 0.85, 0.6
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 4
            orientation: 'vertical'
            padding: "20dp"
            spacing: "15dp"
            MDLabel:
                text: app.get_ar("نظام أميرات صغيرات")
                font_style: "H5"
                bold: True
                halign: "center"
                theme_text_color: "Custom"
                text_color: 0.05, 0.32, 0.58, 1
            MDLabel:
                text: app.get_ar("تسجيل الدخول")
                font_style: "Subtitle1"
                halign: "center"
                theme_text_color: "Secondary"
            MDTextField:
                id: login_username
                mode: "rectangle"
                hint_text: app.get_ar("اسم المستخدم")
                icon_left: "account"
            MDTextField:
                id: login_password
                mode: "rectangle"
                hint_text: app.get_ar("كلمة المرور")
                password: True
                icon_left: "key-variant"
            MDRaisedButton:
                text: app.get_ar("دخول")
                size_hint_x: 1
                height: "48dp"
                md_bg_color: 0.05, 0.32, 0.58, 1
                on_release: app.login_user()

# ====================================
# 1. لوحة القيادة والمؤشرات البصرية
# ====================================
<DashboardScreen>:
    name: 'dashboard'
    on_enter: app.load_dashboard_stats()
    MDFloatLayout:
        md_bg_color: 1, 1, 1, 1
        MDBoxLayout:
            orientation: 'horizontal'
            pos_hint: {"top": 1}
            size_hint_y: 0.08
            md_bg_color: 0.05, 0.32, 0.58, 1
            padding: ["12dp", "0dp"]
            MDIconButton:
                icon: "logout"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                pos_hint: {"center_y": 0.5}
                on_release: app.logout_user()
            MDLabel:
                text: app.get_ar("أميرات صغيرات سوفت")
                font_style: "H6"
                bold: True
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
            MDIconButton:
                id: btn_settings
                icon: "cog"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                pos_hint: {"center_y": 0.5}
                on_release: root.manager.current = 'settings'; app.load_company_profile()

        MDScrollView:
            pos_hint: {"top": 0.92, "bottom": 0.07}
            size_hint_y: 0.85
            MDBoxLayout:
                orientation: 'vertical'
                padding: ["12dp", "16dp"]
                spacing: "10dp"
                adaptive_height: True

                # المؤشرات الذكية
                MDGridLayout:
                    id: dashboard_stats
                    cols: 2
                    spacing: "10dp"
                    adaptive_height: True
                    padding: ["0dp", "0dp", "0dp", "10dp"]
                    MDCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: "70dp"
                        padding: "8dp"
                        md_bg_color: 0.95, 0.98, 1, 1
                        MDLabel:
                            text: app.get_ar("مبيعات اليوم")
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            halign: "center"
                        MDLabel:
                            id: dash_sales
                            text: "$0.00"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.05, 0.32, 0.58, 1
                    MDCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: "70dp"
                        padding: "8dp"
                        md_bg_color: 0.95, 1, 0.95, 1
                        MDLabel:
                            text: app.get_ar("الصندوق الرئيسي")
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            halign: "center"
                        MDLabel:
                            id: dash_safe
                            text: "$0.00"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.1, 0.6, 0.3, 1
                    MDCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: "70dp"
                        padding: "8dp"
                        md_bg_color: 1, 0.95, 0.95, 1
                        MDLabel:
                            text: app.get_ar("فساتين متأخرة")
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            halign: "center"
                        MDLabel:
                            id: dash_late
                            text: "0"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.8, 0.2, 0.2, 1
                    MDCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: "70dp"
                        padding: "8dp"
                        md_bg_color: 1, 0.98, 0.9, 1
                        MDLabel:
                            text: app.get_ar("خامات قاربت للنفاذ")
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            halign: "center"
                        MDLabel:
                            id: dash_stock
                            text: "0"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.45, 0.1, 1

                # أزرار النظام الأساسية
                MDCard:
                    id: card_factory
                    size_hint_y: None
                    height: "50dp"
                    radius: [0, 0, 0, 0]
                    md_bg_color: 0.9, 0.45, 0.1, 1
                    ripple_behavior: True
                    on_release: root.manager.current = 'factory'
                    padding: ["12dp", "0dp"]
                    MDBoxLayout:
                        MDIcon:
                            icon: "sewing-machine"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            pos_hint: {"center_y": 0.5}
                        MDLabel:
                            text: app.get_ar("إدارة معمل الإنتاج وأوامر الشغل")
                            bold: True
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                MDGridLayout:
                    id: box_core_ops
                    cols: 2
                    spacing: "10dp"
                    adaptive_height: True
                    padding: ["5dp", "2dp"]
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: "2dp"
                        adaptive_height: True
                        MDIconButton:
                            icon: "account-group"
                            user_font_size: "28sp"
                            theme_icon_color: "Custom"
                            icon_color: 0.05, 0.32, 0.58, 1
                            pos_hint: {"center_x": 0.5}
                            on_release: root.manager.current = 'customers_smart'
                        MDFillRoundFlatIconButton:
                            text: app.get_ar("العملاء والمقاسات")
                            icon: "plus-circle"
                            md_bg_color: 0.05, 0.32, 0.58, 1
                            font_size: "11sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.manager.current = 'customers_smart'
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: "2dp"
                        adaptive_height: True
                        MDIconButton:
                            icon: "scissors-cutting"
                            user_font_size: "28sp"
                            theme_icon_color: "Custom"
                            icon_color: 0.05, 0.32, 0.58, 1
                            pos_hint: {"center_x": 0.5}
                            on_release: root.manager.current = 'inventory'; app.load_inventory_table()
                        MDFillRoundFlatIconButton:
                            text: app.get_ar("مخزون الأقمشة")
                            icon: "plus-circle"
                            md_bg_color: 0.05, 0.32, 0.58, 1
                            font_size: "11sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.manager.current = 'inventory'; app.load_inventory_table()
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: "2dp"
                        adaptive_height: True
                        MDIconButton:
                            icon: "hanger"
                            user_font_size: "28sp"
                            theme_icon_color: "Custom"
                            icon_color: 0.05, 0.32, 0.58, 1
                            pos_hint: {"center_x": 0.5}
                            on_release: root.manager.current = 'models_costing'; app.load_models_table()
                        MDFillRoundFlatIconButton:
                            text: app.get_ar("منتجات وتكاليف")
                            icon: "plus-circle"
                            md_bg_color: 0.05, 0.32, 0.58, 1
                            font_size: "11sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.manager.current = 'models_costing'; app.load_models_table()
                    MDBoxLayout:
                        orientation: 'vertical'
                        spacing: "2dp"
                        adaptive_height: True
                        MDIconButton:
                            icon: "cart-arrow-down"
                            user_font_size: "28sp"
                            theme_icon_color: "Custom"
                            icon_color: 0.05, 0.32, 0.58, 1
                            pos_hint: {"center_x": 0.5}
                            on_release: root.manager.current = 'purchases'; app.load_purchases_table()
                        MDFillRoundFlatIconButton:
                            text: app.get_ar("فواتير الشراء")
                            icon: "plus-circle"
                            md_bg_color: 0.05, 0.32, 0.58, 1
                            font_size: "10sp"
                            pos_hint: {"center_x": 0.5}
                            on_release: root.manager.current = 'purchases'; app.load_purchases_table()

                MDCard:
                    id: card_sales
                    size_hint_y: None
                    height: "48dp"
                    radius: [0, 0, 0, 0]
                    md_bg_color: 0.05, 0.32, 0.58, 1
                    ripple_behavior: True
                    on_release: root.manager.current = 'sales'; app.load_sales_table()
                    padding: ["12dp", "0dp"]
                    MDBoxLayout:
                        MDIcon:
                            icon: "cart-arrow-right"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            pos_hint: {"center_y": 0.5}
                        MDLabel:
                            text: app.get_ar("المبيعات والحجوزات وإصدار الفواتير")
                            bold: True
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                MDCard:
                    id: card_expenses
                    size_hint_y: None
                    height: "48dp"
                    radius: [0, 0, 0, 0]
                    md_bg_color: 0.8, 0.2, 0.3, 1
                    ripple_behavior: True
                    on_release: root.manager.current = 'expenses'; app.load_expenses_table()
                    padding: ["12dp", "0dp"]
                    MDBoxLayout:
                        MDIcon:
                            icon: "cash-minus"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            pos_hint: {"center_y": 0.5}
                        MDLabel:
                            text: app.get_ar("إضافة مصروفات يومية سريعة")
                            bold: True
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                MDBoxLayout:
                    id: box_accounting
                    orientation: 'vertical'
                    spacing: "2dp"
                    adaptive_height: True
                    MDCard:
                        size_hint_y: None
                        height: "44dp"
                        radius: [0, 0, 0, 0]
                        md_bg_color: 0.05, 0.32, 0.58, 1
                        ripple_behavior: True
                        on_release: root.manager.current = 'journal_entries'; app.load_journal_entries_table()
                        padding: ["12dp", "0dp"]
                        MDBoxLayout:
                            MDIcon:
                                icon: "book-open-page-variant"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                pos_hint: {"center_y": 0.5}
                            MDLabel:
                                text: app.get_ar("قيود اليومية العامة والتسويات")
                                bold: True
                                halign: "right"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                    MDCard:
                        size_hint_y: None
                        height: "44dp"
                        radius: [0, 0, 0, 0]
                        md_bg_color: 0.05, 0.32, 0.58, 1
                        ripple_behavior: True
                        on_release: root.manager.current = 'accounts_tree'; app.load_accounts_tree()
                        padding: ["12dp", "0dp"]
                        MDBoxLayout:
                            MDIcon:
                                icon: "sitemap"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                pos_hint: {"center_y": 0.5}
                            MDLabel:
                                text: app.get_ar("شجرة الحسابات المالية الخماسية")
                                bold: True
                                halign: "right"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                    MDCard:
                        size_hint_y: None
                        height: "44dp"
                        radius: [0, 0, 0, 0]
                        md_bg_color: 0.05, 0.32, 0.58, 1
                        ripple_behavior: True
                        on_release: root.manager.current = 'vouchers'; app.load_vouchers_table()
                        padding: ["12dp", "0dp"]
                        MDBoxLayout:
                            MDIcon:
                                icon: "cash-register"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                pos_hint: {"center_y": 0.5}
                            MDLabel:
                                text: app.get_ar("سندات القبض والصرف والتحويلات")
                                bold: True
                                halign: "right"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                    MDCard:
                        size_hint_y: None
                        height: "44dp"
                        radius: [0, 0, 0, 0]
                        md_bg_color: 0.05, 0.32, 0.58, 1
                        ripple_behavior: True
                        on_release: root.manager.current = 'reports'
                        padding: ["12dp", "0dp"]
                        MDBoxLayout:
                            MDIcon:
                                icon: "chart-box-outline"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                pos_hint: {"center_y": 0.5}
                            MDLabel:
                                text: app.get_ar("التقارير والمركز المالي والأرباح")
                                bold: True
                                halign: "right"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

        MDBoxLayout:
            orientation: 'horizontal'
            pos_hint: {"bottom": 1}
            size_hint_y: 0.07
            md_bg_color: 0.05, 0.32, 0.58, 1
            padding: ["12dp", "0dp"]
            MDLabel:
                id: lbl_logged_user
                text: app.get_ar("معمل الخياطة والإنتاج")
                bold: True
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1

# ====================================
# 2. شاشة معمل الخياطة المعزولة
# ====================================
<FactoryScreen>:
    name: 'factory'
    on_enter: app.load_factory_orders()
    MDFloatLayout:
        md_bg_color: 0.98, 0.97, 0.99, 1
        MDBoxLayout:
            orientation: 'horizontal'
            pos_hint: {"top": 1}
            size_hint_y: 0.08
            md_bg_color: 0.9, 0.45, 0.1, 1
            padding: "8dp"
            MDIconButton:
                icon: "arrow-left"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                on_release: root.manager.current = 'dashboard'
            MDLabel:
                text: app.get_ar("معمل الإنتاج - أوامر الشغل")
                font_style: "Subtitle1"
                bold: True
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
        MDScrollView:
            pos_hint: {"top": 0.92}
            size_hint_y: 0.92
            MDBoxLayout:
                orientation: 'vertical'
                padding: "10dp"
                spacing: "10dp"
                adaptive_height: True
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: "48dp"
                    spacing: "8dp"
                    ArabicTextField:
                        id: search_factory
                        mode: "rectangle"
                        hint_text: app.get_ar("بحث برقم الطلب أو اسم العميلة...")
                    MDIconButton:
                        icon: "magnify"
                        md_bg_color: 0.9, 0.45, 0.1, 1
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        on_release: app.load_factory_orders()
                MDBoxLayout:
                    id: factory_orders_box
                    orientation: 'vertical'
                    spacing: "10dp"
                    adaptive_height: True

# ====================================
# 3. شاشة المبيعات
# ====================================
<SalesScreen>:
    name: 'sales'
    MDFloatLayout:
        md_bg_color: 0.98, 0.97, 0.99, 1
        MDBoxLayout:
            orientation: 'horizontal'
            pos_hint: {"top": 1}
            size_hint_y: 0.08
            md_bg_color: 0.05, 0.32, 0.58, 1
            padding: "8dp"
            MDIconButton:
                icon: "arrow-left"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                on_release: root.manager.current = 'dashboard'
            MDLabel:
                text: app.get_ar("المبيعات وحجوزات التفصيل")
                font_style: "Subtitle1"
                bold: True
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
        MDScrollView:
            pos_hint: {"top": 0.92}
            size_hint_y: 0.92
            MDBoxLayout:
                orientation: 'vertical'
                padding: "10dp"
                spacing: "8dp"
                adaptive_height: True
                MDTextField:
                    id: s_order_date
                    mode: "rectangle"
                    hint_text: app.get_ar("التاريخ")
                    text: app.get_today_date()
                ArabicTextField:
                    id: s_customer
                    mode: "rectangle"
                    hint_text: app.get_ar("اسم العميلة (انقر للسحب)")
                    on_focus: if self.focus: app.open_sales_cust_menu(self)
                MDTextField:
                    id: s_phone
                    mode: "rectangle"
                    hint_text: app.get_ar("رقم الجوال")
                MDTextField:
                    id: s_currency
                    mode: "rectangle"
                    hint_text: app.get_ar("العملة")
                    readonly: True
                    text: app.get_ar("دولار أمريكي (USD)")
                    on_focus: if self.focus: app.open_currency_menu(self)
                ArabicTextField:
                    id: s_product
                    mode: "rectangle"
                    hint_text: app.get_ar("نوع الموديل")
                ArabicTextField:
                    id: s_fabric
                    mode: "rectangle"
                    hint_text: app.get_ar("نوع القماش المستخدم")
                MDGridLayout:
                    cols: 2
                    spacing: "8dp"
                    adaptive_height: True
                    MDTextField:
                        id: s_total
                        mode: "rectangle"
                        hint_text: app.get_ar("الإجمالي")
                        input_filter: "float"
                    MDTextField:
                        id: s_paid
                        mode: "rectangle"
                        hint_text: app.get_ar("المدفوع")
                        input_filter: "float"
                MDTextField:
                    id: s_status
                    mode: "rectangle"
                    hint_text: app.get_ar("حالة الخياطة")
                    readonly: True
                    text: app.get_ar("في الانتظار ⏳")
                    on_focus: if self.focus: app.open_status_menu(self)
                MDGridLayout:
                    cols: 2
                    spacing: "8dp"
                    adaptive_height: True
                    MDTextField:
                        id: s_delivery_date
                        mode: "rectangle"
                        hint_text: app.get_ar("تاريخ الاستلام")
                        text: "2026-07-30"
                    MDTextField:
                        id: s_delivery_fees
                        mode: "rectangle"
                        hint_text: app.get_ar("أجور التوصيل")
                        text: "3.0"
                        input_filter: "float"
                ArabicTextField:
                    id: s_notes
                    mode: "rectangle"
                    multiline: True
                    hint_text: app.get_ar("ملاحظات")
                MDGridLayout:
                    cols: 2
                    spacing: "6dp"
                    adaptive_height: True
                    MDRaisedButton:
                        text: app.get_ar("حفظ الفاتورة")
                        md_bg_color: 0.1, 0.45, 0.75, 1
                        height: "44dp"
                        on_release: app.save_sale_order()
                    MDRaisedButton:
                        text: app.get_ar("طباعة الفاتورة + PDF")
                        md_bg_color: 0.5, 0.2, 0.6, 1
                        height: "44dp"
                        on_release: app.generate_pdf_invoice()
                    MDRaisedButton:
                        text: app.get_ar("أمر التوصيل للموصل")
                        md_bg_color: 0.9, 0.45, 0.1, 1
                        height: "44dp"
                        on_release: app.send_driver_order()
                    MDRaisedButton:
                        text: app.get_ar("إرسال للمعمل")
                        md_bg_color: 0.1, 0.55, 0.3, 1
                        height: "44dp"
                        on_release: app.send_workshop_order()
                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: "48dp"
                    spacing: "8dp"
                    ArabicTextField:
                        id: search_sales
                        mode: "rectangle"
                        hint_text: app.get_ar("بحث في الفواتير...")
                    MDIconButton:
                        icon: "magnify"
                        md_bg_color: 0.05, 0.32, 0.58, 1
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        on_release: app.load_sales_table()
                MDBoxLayout:
                    id: sales_list_box
                    orientation: 'vertical'
                    spacing: "2dp"
                    adaptive_height: True

# ====================================
# 4. شاشة العملاء والمقاسات (الكاملة المحدثة بالسلة)
# ====================================
<CustomersSmartScreen>:
    name: 'customers_smart'
    MDFloatLayout:
        md_bg_color: 0.98, 0.97, 0.99, 1
        MDBoxLayout:
            orientation: 'horizontal'
            pos_hint: {"top": 1}
            size_hint_y: 0.08
            md_bg_color: 0.05, 0.32, 0.58, 1
            padding: "8dp"
            MDIconButton:
                icon: "arrow-left"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                on_release: root.manager.current = 'dashboard'
            MDLabel:
                text: app.get_ar("العملاء والمقاسات (سلة متعددة)")
                font_style: "Subtitle1"
                bold: True
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
        MDScrollView:
            pos_hint: {"top": 0.92}
            size_hint_y: 0.92
            MDBoxLayout:
                orientation: 'vertical'
                padding: "12dp"
                spacing: "8dp"
                adaptive_height: True
                
                # --- 1. بيانات العميل التفصيلية ---
                ArabicTextField:
                    id: cust_name
                    mode: "rectangle"
                    hint_text: app.get_ar("اسم العميل")
                MDTextField:
                    id: cust_phone
                    mode: "rectangle"
                    hint_text: app.get_ar("رقم الهاتف")
                MDGridLayout:
                    cols: 2
                    spacing: "8dp"
                    adaptive_height: True
                    MDTextField:
                        id: cust_purchases_count
                        mode: "rectangle"
                        hint_text: app.get_ar("مرات الشراء")
                        text: "1"
                        input_filter: "int"
                    MDTextField:
                        id: cust_type
                        mode: "rectangle"
