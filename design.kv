                id: accounts_list_box
                orientation: 'vertical'
                padding: ["4dp", "4dp"]
                spacing: "2dp"
                adaptive_height: True

# ====================================
# 12. التقارير الختامية
# ====================================
<ReportsScreen>:
    name: 'reports'
    MDFloatLayout:
        md_bg_color: 0.98, 0.97, 0.99, 1
        MDBoxLayout:
            orientation: 'horizontal'
            pos_hint: {"top": 1}
            size_hint_y: 0.08
            md_bg_color: 0.05, 0.32, 0.58, 1
            padding: "8dp"
            MDIconButton:
                icon: "arrow-left"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                on_release: root.manager.current = 'dashboard'
            MDLabel:
                text: app.get_ar("التقارير المحاسبية")
                font_style: "Subtitle1"
                bold: True
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
        MDScrollView:
            pos_hint: {"top": 0.92}
            size_hint_y: 0.92
            MDBoxLayout:
                orientation: 'vertical'
                padding: "10dp"
                spacing: "8dp"
                adaptive_height: True
                MDCard:
                    size_hint_y: None
                    height: "55dp"
                    radius: [0, 0, 0, 0]
                    line_color: 0.85, 0.85, 0.85, 1
                    padding: "8dp"
                    on_release: app.show_dialog("ميزان المراجعة", "الأرصدة متوازنة بنسبة 100%.")
                    MDBoxLayout:
                        MDLabel:
                            text: app.get_ar("ميزان المراجعة")
                            bold: True
                        MDIconButton:
                            icon: "scale-balance"
                MDCard:
                    size_hint_y: None
                    height: "55dp"
                    radius: [0, 0, 0, 0]
                    line_color: 0.85, 0.85, 0.85, 1
                    padding: "8dp"
                    on_release: app.show_dialog("المركز المالي", "كشف الأصول والخصوم.")
                    MDBoxLayout:
                        MDLabel:
                            text: app.get_ar("المركز المالي")
                            bold: True
                        MDIconButton:
                            icon: "bank-outline"
                MDCard:
                    size_hint_y: None
                    height: "55dp"
                    radius: [0, 0, 0, 0]
                    line_color: 0.85, 0.85, 0.85, 1
                    padding: "8dp"
                    on_release: app.show_dialog("قائمة الدخل", "كشف الأرباح الصافية.")
                    MDBoxLayout:
                        MDLabel:
                            text: app.get_ar("قائمة الدخل")
                            bold: True
                        MDIconButton:
                            icon: "chart-line"

# ====================================
# 13. الإعدادات، التصدير، والإقفال
# ====================================
<SettingsScreen>:
    name: 'settings'
    MDFloatLayout:
        md_bg_color: 0.98, 0.97, 0.99, 1
        MDBoxLayout:
            orientation: 'horizontal'
            pos_hint: {"top": 1}
            size_hint_y: 0.08
            md_bg_color: 0.05, 0.32, 0.58, 1
            padding: "8dp"
            MDIconButton:
                icon: "arrow-left"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                on_release: root.manager.current = 'dashboard'
            MDLabel:
                text: app.get_ar("الإعدادات والتصدير")
                font_style: "Subtitle1"
                bold: True
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
        MDScrollView:
            pos_hint: {"top": 0.92}
            size_hint_y: 0.92
            MDBoxLayout:
                orientation: 'vertical'
                padding: "12dp"
                spacing: "16dp"
                adaptive_height: True
                MDLabel:
                    text: app.get_ar("بيانات المنشأة (Company Profile)")
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.05, 0.32, 0.58, 1
                ArabicTextField:
                    id: cmp_name
                    mode: "rectangle"
                    hint_text: app.get_ar("اسم المنشأة")
                MDTextField:
                    id: cmp_phone
                    mode: "rectangle"
                    hint_text: app.get_ar("الهاتف")
                ArabicTextField:
                    id: cmp_address
                    mode: "rectangle"
                    hint_text: app.get_ar("العنوان")
                MDTextField:
                    id: cmp_email
                    mode: "rectangle"
                    hint_text: app.get_ar("الإيميل")
                MDBoxLayout:
                    orientation: 'horizontal'
                    spacing: "8dp"
                    size_hint_y: None
                    height: "56dp"
                    MDTextField:
                        id: cmp_logo
                        mode: "rectangle"
                        hint_text: app.get_ar("مسار الشعار (Logo)")
                        readonly: True
                    MDIconButton:
                        icon: "folder-image"
                        pos_hint: {"center_y": 0.5}
                        on_release: app.open_logo_chooser()
                MDRaisedButton:
                    text: app.get_ar("حفظ بيانات المنشأة")
                    size_hint_x: 1
                    height: "46dp"
                    md_bg_color: 0.05, 0.32, 0.58, 1
                    on_release: app.save_company_profile()
                MDLabel:
                    text: app.get_ar("العملات والإقفال")
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.05, 0.32, 0.58, 1
                MDGridLayout:
                    cols: 2
                    spacing: "8dp"
                    adaptive_height: True
                    MDTextField:
                        id: cfg_yer_rate
                        mode: "rectangle"
                        hint_text: app.get_ar("صرف الدولار")
                        text: "530"
                    MDTextField:
                        id: cfg_sar_rate
                        mode: "rectangle"
                        hint_text: app.get_ar("صرف السعودي")
                        text: "140"
                MDRaisedButton:
                    text: app.get_ar("إجراء الإقفال السنوي")
                    size_hint_x: 1
                    height: "46dp"
                    md_bg_color: 0.7, 0.2, 0.2, 1
                    on_release: app.process_year_end_closing()
                MDLabel:
                    text: app.get_ar("النسخ الاحتياطي والتصدير")
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.05, 0.32, 0.58, 1
                MDGridLayout:
                    cols: 2
                    spacing: "8dp"
                    adaptive_height: True
                    MDRaisedButton:
                        text: app.get_ar("تصدير (PDF)")
                        size_hint_x: 1
                        md_bg_color: 0.8, 0.2, 0.2, 1
                        on_release: app.open_export_dialog('pdf')
                    MDRaisedButton:
                        text: app.get_ar("تصدير (Excel)")
                        size_hint_x: 1
                        md_bg_color: 0.1, 0.6, 0.3, 1
                        on_release: app.export_data('excel')
                    MDRaisedButton:
                        text: app.get_ar("تصدير (Word)")
                        size_hint_x: 1
                        md_bg_color: 0.1, 0.3, 0.8, 1
                        on_release: app.export_data('word')
                    MDRaisedButton:
                        text: app.get_ar("إرسال البيانات")
                        size_hint_x: 1
                        md_bg_color: 0.5, 0.2, 0.6, 1
                        on_release: app.send_database()
                MDRaisedButton:
                    text: app.get_ar("إنشاء نسخة احتياطية")
                    size_hint_x: 1
                    height: "46dp"
                    md_bg_color: 0.4, 0.4, 0.4, 1
                    on_release: app.backup_database()
                MDRaisedButton:
                    text: app.get_ar("استيراد قاعدة البيانات")
                    size_hint_x: 1
                    height: "46dp"
                    md_bg_color: 0.9, 0.45, 0.1, 1
                    on_release: app.import_database()