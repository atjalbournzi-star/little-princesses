  var createdCount = 0;
  for (var sheetName in tablesData) {
    var sheet = ss.getSheetByName(sheetName);
    if (!sheet) {
      sheet = ss.insertSheet(sheetName);
    } else {
      sheet.clear();
    }
    
    // تفعيل اتجاه اليمين لليسار
    sheet.setRightToLeft(true);
    
    var headers = tablesData[sheetName].headers;
    var rows = tablesData[sheetName].rows;
    
    // كتابة الهيدر
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    
    // تنسيق الهيدر بالألوان الملكية
    var headerRange = sheet.getRange(1, 1, 1, headers.length);
    headerRange.setBackground("#1E2433");
    headerRange.setFontColor("#FFFFFF");
    headerRange.setFontWeight("bold");
    headerRange.setFontSize(10.5);
    headerRange.setHorizontalAlignment("center");
    headerRange.setVerticalAlignment("middle");
    headerRange.setWrap(true);
    sheet.setRowHeight(1, 38);
    sheet.setFrozenRows(1);
    
    // تعبئة البيانات القياسية
    if (rows && rows.length > 0) {
      var dataRange = sheet.getRange(2, 1, rows.length, headers.length);
      dataRange.setValues(rows);
      dataRange.setFontSize(10);
      dataRange.setVerticalAlignment("middle");
      
      // تخطيط وتلوين الخطوط
      dataRange.setBorder(true, true, true, true, true, true, "#E8E5EA", SpreadsheetApp.BorderStyle.SOLID);
    }
    
    // ضبط عرض الأعمدة تلقائياً
    for (var col = 1; col <= headers.length; col++) {
      sheet.setColumnWidth(col, Math.max(140, Math.min(260, headers[col - 1].length * 14)));
    }
    
    createdCount++;
  }

  // حذف الورقة الافتراضية 'Sheet1' أو 'ورقة1' إن وجدت وكانت فارغة
  try {
    var defaultSheet = ss.getSheetByName('Sheet1') || ss.getSheetByName('ورقة1');
    if (defaultSheet && ss.getSheets().length > 1) {
      ss.deleteSheet(defaultSheet);
    }
  } catch (e) {}

  SpreadsheetApp.getUi().alert(
    "👑 تم تأسيس قاعدة بيانات Little Princesses بنجاح!\n\n" +
    "✅ تم إنشاء وتنسيق " + createdCount + " ورقة عمل قياسية باللغة العربية.\n" +
