  setupERPDatabaseWithData();
}

/**
 * أرشفة وتنظيف الأوراق القديمة غير القياسية
 */
function archiveLegacySheets(ss) {
  if (!ss) ss = SpreadsheetApp.getActiveSpreadsheet();
  var standardSheets = [
    'العملاء', 'المقاسات', 'المنتجات', 'المخزون_والمستودعات', 'المشتريات_والموردون',
    'الطلبات', 'دليل_الحسابات', 'السندات_المالية', 'القيود_اليومية', 'المصروفات',
    'أوامر_الإنتاج', 'الموظفون', 'كشوفات_المرتبات', 'تقييمات_الجودة', 'حملات_التسويق',
    'بروفايل_المؤسسة', 'المستخدمون'
  ];

  var allSheets = ss.getSheets();
  var archivedCount = 0;
  
  allSheets.forEach(function(sh) {
    var sName = sh.getName();
    // إذا كانت الورقة قديمة باللغة الإنجليزية أو ذات اسم غير قياسي وليست مأرشفة بعد
    if (standardSheets.indexOf(sName) === -1 && !sName.startsWith('_Archive_') && sName !== 'Sheet1' && sName !== 'ورقة1') {
      try {
        sh.setName('_Archive_' + sName);
        sh.setTabColor('#9E9E9E');
        archivedCount++;
      } catch (e) {
        console.warn("Could not rename sheet: " + sName);
      }
    }
  });

  return archivedCount;
}
